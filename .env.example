# Copia como .env. Nunca confirmes valores reales o secretos.
TALLER_ENTORNO=local
TALLER_MONGODB_URI=mongodb://localhost:27017/?replicaSet=rs0
TALLER_MONGODB_DATABASE=taller
TALLER_OIDC_ISSUER=https://TU_TENANT.auth0.com/
TALLER_OIDC_AUDIENCE=https://taller-api.local
